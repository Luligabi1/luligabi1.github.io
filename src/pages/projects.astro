---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import ModCard from "../components/ModCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects</div>
  </div>

  <HorizontalCard
    title="Sabotador.com"
    img="/sabotador/icon.svg"
    desc="Sabotador.com is a Minecraft Server reviving the classic Sabotage minigame for the Brazilian and Portuguese communities. Features multiple balance changes, seasonal events, game modifiers and more!"
    url="sabotador"
    tags={["Spigot 1.8.8", "Paper 1.21.5", "Kotlin", "Java"]}
  />

  <div>
    <div id="minecraft" class="text-3xl w-full font-bold mb-5 mt-10 scroll-mt-10">Minecraft Mods</div>
  </div>

  <ModCard mod="hostileNeuralIndustrialization" />
  <ModCard mod="enhancedWorkbenches" />
  <ModCard mod="amimi" />
  <ModCard mod="fuelInfo" />
  <ModCard mod="incantationem" />
  <ModCard mod="yetAnotherIndustrialization" />
  <ModCard mod="coxinhaUtilities" />
  <ModCard mod="deepMobLearningRefabricated" />
  <ModCard mod="logicates" />

  <div>
    <div id="hytale" class="text-3xl w-full font-bold mb-5 mt-10 scroll-mt-10">Hytale Mods</div>
  </div>

  <ModCard mod="barelyBaskets" />

</BaseLayout>
