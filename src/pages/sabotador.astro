---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title = "Sabotador.com" sideBarActiveItemID="sabotador">

  <img src="/sabotador/header.svg" alt="Sabotador Header" ... />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">What is Sabotage?</div>
  </div>

  <div class="pb-4 mt-5">
    <div class="py-2">
      <p class="text-lg text-justify">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea
        commodo consequat.
      </p>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Game Modifiers</div>
  </div>

  <div class="pb-4 mt-5">
    <div class="py-2">
      <p class="text-lg text-justify">
        Game Modifiers freshen up matches by introducing gameplay changes not present in regular playing.
      </p>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Seasonal events</div>
  </div>

  <div class="pb-4 mt-5">
    <div class="py-2">
      <p class="text-lg text-justify">
        Seasonal events are also available off-season as game modifiers.
      </p>
    </div>
  </div>

  <div>
    <div class="text-2xl w-full font-bold mb-5 mt-10">Voted Modifiers</div>
  </div>

  <div class="pb-4 mt-5">
    <div class="py-2">
      <p class="text-lg text-justify">
        After returning to the lobby, there's a 20% chance a vote to activate a random modifier will begin;
      </p>
    </div>
  </div>

</BaseLayout>
