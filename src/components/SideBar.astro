---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col">
    <div class="w-fit mx-auto mt-5 mb-6">
      <a href="/">
        <div class="profile-flip block m-auto w-[8.5rem] h-[8.5rem]">
          <div class="profile-flip-inner">
            <div class="profile-face">
              <Image class="mask mask-circle w-full h-full object-cover" format="webp" width={300} height={300} src="/profile.webp" alt="" />
            </div>
          </div>
        </div>
      </a>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>

<style>
  .profile-flip {
    perspective: 800px;
  }
  .profile-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 2.5s cubic-bezier(0.45, 0, 0.25, 1);
  }
  .profile-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  let rotation = 0;
  let animating = false;

  document.addEventListener("mouseover", (e) => {
    const target = e.target as HTMLElement;
    const flip = target.closest<HTMLElement>(".profile-flip");
    if (!flip || animating) return;
    if (e.relatedTarget && flip.contains(e.relatedTarget as Node)) return;
    const inner = flip.querySelector<HTMLElement>(".profile-flip-inner");
    if (!inner) return;
    animating = true;
    rotation += 360;
    inner.style.transform = `rotateY(${rotation}deg)`;
  });

  document.addEventListener("transitionend", (e) => {
    if ((e.target as HTMLElement).classList?.contains("profile-flip-inner")) animating = false;
  });

  document.addEventListener("astro:after-swap", () => {
    animating = false;
    rotation %= 360;
    const inner = document.querySelector<HTMLElement>(".profile-flip-inner");
    if (inner) inner.style.transform = `rotateY(${rotation}deg)`;
  });
</script>
