---
const { title, img, desc, badges, tags, github, curseforge, modrinth, target = "_blank" } = Astro.props;

import { Image } from "astro:assets";
import { marked } from 'marked';


const descHtml = marked.parse(desc);

const badgeColors = {
    "Neoforge": "#A94E0D",
    "Fabric": "#BCB29C",
    "Modern": "#2da72d",
    "Java": "#f89820",
    "Kotlin": "#7F52FF",
};

const githubSvg = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z"/></svg>';

const curseforgeSvg = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.326 9.2145S23.2261 8.4418 24 6.1882h-7.5066V4.4H0l2.0318 2.3576V9.173s5.1267-.2665 7.1098 1.2372c2.7146 2.516-3.053 5.917-3.053 5.917L5.0995 19.6c1.5465-1.4726 4.494-3.3775 9.8983-3.2857-2.0565.65-4.1245 1.6651-5.7344 3.2857h10.9248l-1.0288-3.2726s-7.918-4.6688-.8336-7.1127z"/></svg>';

const modrinthSvg = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.252.004a11.78 11.768 0 0 0-8.92 3.73 11 10.999 0 0 0-2.17 3.11 11.37 11.359 0 0 0-1.16 5.169c0 1.42.17 2.5.6 3.77.24.759.77 1.899 1.17 2.529a12.3 12.298 0 0 0 8.85 5.639c.44.05 2.54.07 2.76.02.2-.04.22.1-.26-1.7l-.36-1.37-1.01-.06a8.5 8.489 0 0 1-5.18-1.8 5.34 5.34 0 0 1-1.3-1.26c0-.05.34-.28.74-.5a37.572 37.545 0 0 1 2.88-1.629c.03 0 .5.45 1.06.98l1 .97 2.07-.43 2.06-.43 1.47-1.47c.8-.8 1.48-1.5 1.48-1.52 0-.09-.42-1.63-.46-1.7-.04-.06-.2-.03-1.02.18-.53.13-1.2.3-1.45.4l-.48.15-.53.53-.53.53-.93.1-.93.07-.52-.5a2.7 2.7 0 0 1-.96-1.7l-.13-.6.43-.57c.68-.9.68-.9 1.46-1.1.4-.1.65-.2.83-.33.13-.099.65-.579 1.14-1.069l.9-.9-.7-.7-.7-.7-1.95.54c-1.07.3-1.96.53-1.97.53-.03 0-2.23 2.48-2.63 2.97l-.29.35.28 1.03c.16.56.3 1.16.31 1.34l.03.3-.34.23c-.37.23-2.22 1.3-2.84 1.63-.36.2-.37.2-.44.1-.08-.1-.23-.6-.32-1.03-.18-.86-.17-2.75.02-3.73a8.84 8.839 0 0 1 7.9-6.93c.43-.03.77-.08.78-.1.06-.17.5-2.999.47-3.039-.01-.02-.1-.02-.2-.03Zm3.68.67c-.2 0-.3.1-.37.38-.06.23-.46 2.42-.46 2.52 0 .04.1.11.22.16a8.51 8.499 0 0 1 2.99 2 8.38 8.379 0 0 1 2.16 3.449 6.9 6.9 0 0 1 .4 2.8c0 1.07 0 1.27-.1 1.73a9.37 9.369 0 0 1-1.76 3.769c-.32.4-.98 1.06-1.37 1.38-.38.32-1.54 1.1-1.7 1.14-.1.03-.1.06-.07.26.03.18.64 2.56.7 2.78l.06.06a12.07 12.058 0 0 0 7.27-9.4c.13-.77.13-2.58 0-3.4a11.96 11.948 0 0 0-5.73-8.578c-.7-.42-2.05-1.06-2.25-1.06Z"/></svg>';
---

<div
        class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
    <a>
        <div class="hero-content flex-col md:flex-row">
            {
                img && (
                            <Image
                                    src={img}
                                    width={256}
                                    height={256}
                                    format="webp"
                                    alt={title}
                                    class="max-w-full md:max-w-[8rem] rounded-lg"
                            />
                )
            }

            <div class="grow w-full">
                <h1 class="text-xl font-bold">
                    {title}
                    {
                        badges?.map((badge) => (
                                <div
                                        class="badge mx-1"
                                        style={`background-color: ${badgeColors[badge] ?? "#6b7280"}; color: white;`}
                                >
                                    {badge}
                                </div>
                        ))
                    }
                </h1>

                <p class="py-1 text-1xl" set:html={descHtml} />
            </div>
        </div>
    </a>

    <div class="flex gap-2 px-4 pb-2 flex-wrap">
        {github && (
                <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline platform-btn platform-github" aria-label="GitHub" title="GitHub">
                    <Fragment set:html={githubSvg} />
                    GitHub
                </a>
        )}
        {curseforge && (
                <a href={curseforge} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline platform-btn platform-curseforge" aria-label="CurseForge" title="CurseForge">
                    <Fragment set:html={curseforgeSvg} />
                    CurseForge
                </a>
        )}
        {modrinth && (
                <a href={modrinth} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline platform-btn platform-modrinth" aria-label="Modrinth" title="Modrinth">
                    <Fragment set:html={modrinthSvg} />
                    Modrinth
                </a>
        )}
    </div>

    <div class="card-actions justify-end px-4 pb-4">
        {
            tags &&
            tags.map((tag) => (
                    <a href={tag} class="badge badge-outline">
                        {tag}
                    </a>
            ))
        }
    </div>
</div>

<style>
    .platform-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .platform-github:hover {
        background-color: #181717;
        border-color: #181717;
        color: #fff;
    }
    .platform-curseforge:hover {
        background-color: #F16436;
        border-color: #F16436;
        color: #fff;
    }
    .platform-modrinth:hover {
        background-color: #1BD96A;
        border-color: #1BD96A;
        color: #fff;
    }
</style>