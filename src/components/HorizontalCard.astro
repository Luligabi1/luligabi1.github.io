---
const { title, img, desc, url, tags, target = "_blank" } = Astro.props;

import { Image } from "astro:assets";
import { badgeColors } from "../data/badgeColors";
---

<div
    class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
          img && (
              <Image
                  src={img}
                  width={256}
                  height={256}
                  format="webp"
                  alt={title}
                  class="max-w-full md:max-w-[8rem] rounded-lg"
              />
          )
      }

      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {
            tags?.map((tag) => (
                <div
                    class="badge mx-1"
                    style={`background-color: ${badgeColors[tag] ?? "#6b7280"}; color: white;`}
                >
                  {tag}
                </div>
            ))
          }
        </h1>

        <p class="py-1 text-1xl">{desc}</p>
      </div>
    </div>
  </a>
</div>