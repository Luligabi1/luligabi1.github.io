---
const { title, img, desc, url, badges, tags, target = "_blank" } = Astro.props;

import { Image } from "astro:assets";

const badgeColors = {
  "Spigot 1.8.8": "#EF9127",
  "Paper 1.21.5": "#2B7FFF",
  "Neoforge": "#A94E0D",
  "Fabric": "#BCB29C",
  "Modern": "#2da72d",
  "Java": "#f89820",
  "Kotlin": "#7F52FF",
};

const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
    class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
          img && (
              <Image
                  src={img}
                  width={256}
                  height={256}
                  format="webp"
                  alt={title}
                  class="max-w-full md:max-w-[8rem] rounded-lg"
              />
          )
      }

      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {
            badges?.map((badge) => (
                <div
                    class="badge mx-1"
                    style={`background-color: ${badgeColors[badge] ?? "#6b7280"}; color: white;`}
                >
                  {badge}
                </div>
            ))
          }
        </h1>

        <p class="py-1 text-1xl">{desc}</p>

        <div class="card-actions justify-end">
          {
              tags &&
              tags.map((tag) => (
                  <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                    {tag}
                  </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>